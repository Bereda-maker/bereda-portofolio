# Postgres connection string (Railway provides this automatically as
# DATABASE_URL when you attach a Postgres plugin to this service; for local
# dev, point it at a local or a Railway-hosted database).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Random 32+ character secret used to encrypt the admin session cookie.
# Generate one locally, e.g.: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# bcrypt hash of the single admin password (never store the plain password).
# Generate one locally, e.g.:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash

# Optional integrations. Leave unset until the provider is selected and credentials are configured.
# PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM=
# CALENDAR_PROVIDER=
# CALENDAR_API_KEY=
# CALENDAR_ID=
# AI_PROVIDER=
# AI_API_KEY=
